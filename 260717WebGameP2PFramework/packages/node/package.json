{
  "name": "@relayplay/node",
  "version": "0.1.0",
  "description": "Hardened self-hosted Node.js HTTP, WebSocket, anonymous guest, and SQLite adapter for RelayPlay.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "relayplay-node": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run test"
  },
  "dependencies": {
    "@relayplay/core": "0.1.0",
    "@relayplay/server": "0.1.0",
    "ws": "^8.21.1"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
