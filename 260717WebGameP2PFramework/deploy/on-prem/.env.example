# DNS name handled by Caddy. Do not include a scheme or path.
RELAYPLAY_SITE_ADDRESS=play.example.com

# Exact browser Origin accepted by POST and WebSocket requests.
RELAYPLAY_PUBLIC_ORIGIN=https://play.example.com

# Optional host port overrides.
RELAYPLAY_HTTP_PORT=80
RELAYPLAY_HTTPS_PORT=443

# Stable volume names make backup/restore commands predictable.
RELAYPLAY_DATA_VOLUME=relayplay_data
RELAYPLAY_CADDY_DATA_VOLUME=relayplay_caddy_data
RELAYPLAY_CADDY_CONFIG_VOLUME=relayplay_caddy_config

# Conservative single-node limits; tune only after load testing.
RELAYPLAY_MAX_CONNECTIONS=1000
RELAYPLAY_MAX_CONNECTIONS_PER_IP=8

# /metrics remains internal because Caddy does not proxy it.
RELAYPLAY_EXPOSE_METRICS=false
