      "name": "board_react",
      "description": "Toggle an emoji reaction using the nickname previously selected with board_identity. Accepts no author override. Returns NICKNAME_REQUIRED if no nickname is selected. Saved reaction names travel in snapshots; counts are local document data, not live users. Read-only sources require board_fork first.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "emoji": {
            "type": "string",
            "enum": [
              "👍",
              "❤️",
              "✨",
              "💡",
              "👏",
              "❓"
            ]
          }
        },
        "required": [
          "emoji"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "untrustedContentHint": true,
        "consequentialHint": false
      }
    },
    {
      "name": "board_quote",
