                          "maxLength": 2000
                        },
                        "fontSize": {
                          "type": "integer",
                          "minimum": 8,
                          "maximum": 256
                        },
                        "stroke": {
                          "type": "string",
                          "pattern": "^#[0-9a-fA-F]{6}$"
                        },
                        "fill": {
                          "type": "string",
                          "pattern": "^(#[0-9a-fA-F]{6}|transparent|none)$"
                        },
                        "strokeWidth": {
                          "type": "integer",
