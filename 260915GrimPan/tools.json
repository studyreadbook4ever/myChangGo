      "annotations": {
        "readOnlyHint": false,
        "untrustedContentHint": true,
        "consequentialHint": false
      }
    },
    {
      "name": "board_identity",
      "description": "Set a display nickname for the CURRENT TAB only. This is not login or authentication. It changes in-memory UI state without saving the nickname to browser storage. New reactions use this nickname; display names attached to saved reactions remain public board data.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "nickname": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
