    {
      "name": "agent_move",
      "description": "Move the visible agent freely to absolute x,y OR by dx,dy, in document coordinates. If its pen is down this draws a line from the previous position. There is no maze or obstacle restriction.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "x": {
            "type": "integer",
            "minimum": -100000,
            "maximum": 100000
          },
          "y": {
            "type": "integer",
            "minimum": -100000,
            "maximum": 100000
          },
          "dx": {
            "type": "integer",
            "minimum": -100000,
            "maximum": 100000
          },
          "dy": {
            "type": "integer",
            "minimum": -100000,
            "maximum": 100000
          }
        },
        "required": [],
        "additionalProperties": false,
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer",
                "minimum": -100000,
                "maximum": 100000
              },
              "y": {
                "type": "integer",
                "minimum": -100000,
                "maximum": 100000
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "dx": {
