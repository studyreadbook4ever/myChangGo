      }
    },
    {
      "name": "board_view",
      "description": "Set the viewport. x,y are SCREEN pixel translation, zoom is 0.1–4. screen = document * zoom + translation. Does not edit drawing objects.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "x": {
