            ],
            "additionalProperties": false
          }
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "untrustedContentHint": true,
        "consequentialHint": false
      }
    },
    {
      "name": "agent_turn",
      "description": "Set the agent heading to an absolute angle in degrees: 0 right, 90 down, 180 left, 270 up. This changes orientation only; moving uses x,y or dx,dy.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "angle": {
            "type": "integer",
            "minimum": -360000,
            "maximum": 360000
          }
        },
        "required": [
          "angle"
        ],
        "additionalProperties": false
      },
      "annotations": {
