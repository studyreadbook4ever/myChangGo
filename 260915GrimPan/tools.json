                        },
                        "strokeWidth": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 100
                        },
                        "rotation": {
                          "type": "integer",
                          "minimum": -360000,
                          "maximum": 360000
                        }
                      },
                      "required": [],
                      "additionalProperties": false,
                      "minProperties": 1
                    }
                  },
                  "required": [
                    "type",
