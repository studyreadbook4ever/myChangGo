{
  "name": "chzzk-kirinuki-prompt-extension",
  "version": "2.5.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "studio": "bash ./kirinuki.sh",
    "acquire:youtube": "node scripts/acquire-youtube.mjs",
    "build": "node scripts/build-editor.mjs",
    "dev:editor": "node scripts/dev-extension.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:hot-reload": "node scripts/browser-smoke.mjs --dev-reload",
    "test:export": "node scripts/media-export-e2e.mjs",
    "test:interaction": "node scripts/editor-interaction-e2e.mjs",
    "validate": "node scripts/validate-extension.mjs",
    "license:check": "node scripts/check-third-party-licenses.mjs",
    "audit": "npm audit --audit-level=high",
    "check": "npm run build && npm run validate && npm run license:check && npm test && npm run audit",
    "check:full": "npm run check && npm run test:browser && npm run test:hot-reload && npm run test:interaction && npm run test:export",
    "package": "node scripts/release-package.mjs",
    "check:policy-links": "node scripts/check-policy-links.mjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "mediabunny": "1.51.0"
  },
  "devDependencies": {
    "esbuild": "0.25.6"
  }
}
